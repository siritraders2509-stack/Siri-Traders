# Supabase Postgres connection string (transaction pooler, port 6543).
# On Cloudflare, this is only used for local Node scripts (db/seed.js,
# drizzle-kit) — the deployed app gets its connection via the Hyperdrive
# binding in wrangler.toml instead (see db/index.js's configureDb()).
DATABASE_URL=postgresql://user:password@host:6543/dbname?sslmode=require

# Clerk Keys (Get yours from dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_placeholder_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Admin auth
ADMIN_SECRET=placeholder_shared_secret
ADMIN_JWT_SECRET=placeholder_long_random_string
ADMIN_EMAIL=placeholder@example.com

# Same-origin frontend URL, used for CORS allow-list fallback
FRONTEND_URL=https://www.siritrader.com

# Resend (Get your API key from resend.com) — replaces nodemailer/SMTP,
# which can't open raw sockets on Cloudflare Workers.
RESEND_API_KEY=placeholder_resend_key
RESEND_FROM=Siri Traders <notifications@siritrader.com>

# Supabase Storage (image uploads — api/upload.js). Same Supabase project as
# DATABASE_URL above. SUPABASE_URL is your project's base URL
# (https://<project-ref>.supabase.co); SUPABASE_SERVICE_ROLE_KEY is from
# Project Settings -> API (the "service_role" secret key, not the anon key —
# uploads need to bypass Storage RLS). Create a public bucket named
# "uploads" (or set SUPABASE_STORAGE_BUCKET to whatever you name it) under
# Storage in the Supabase dashboard first.
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key
SUPABASE_STORAGE_BUCKET=uploads

# Upstash Redis (Get yours from console.upstash.com)
UPSTASH_REDIS_REST_URL=https://placeholder-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder_token

# MSG91 SMS (Get your auth key from control.msg91.com; sender ID and templates
# must be DLT-registered for sending to Indian numbers — see DLT registration
# steps in project docs/chat history)
MSG91_AUTH_KEY=placeholder_auth_key
MSG91_SENDER_ID=SIRITR
# Route used for promotional broadcasts (offers/coupons) — 6 = promotional, 4 = transactional
MSG91_PROMO_ROUTE=6
# Phone number (with country code) that receives new-order alerts
ADMIN_PHONE_NUMBER=+918125702866
# DLT Content Template IDs (from control.msg91.com/dlt) — each must match the
# exact wording of the template hardcoded for that message in api/_sms.js
MSG91_DLT_TE_ID_ADMIN_ORDER=placeholder_template_id
MSG91_DLT_TE_ID_ORDER_STATUS=placeholder_template_id
MSG91_DLT_TE_ID_PROMO=placeholder_template_id
